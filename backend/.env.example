NODE_ENV=development
PORT=3001

# URLs dos frontends (em PRD, troque pelas URLs HTTPS do Cloudflare Pages / Vercel / dominio proprio)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
HUB_APP_URL=http://localhost:3000
MINDMAP_APP_URL=http://localhost:3002
FLOWCHART_APP_URL=http://localhost:3003
ERSTUDIO_APP_URL=http://localhost:3004
SESSION_TTL_DAYS=7

# Banco de dados
# - Se DATABASE_URL estiver definida -> usa PostgreSQL (ex.: Neon / Supabase em PRD)
# - Se DATABASE_URL estiver vazia -> usa SQLite local (dev)
DATABASE_URL=
# Opcional: 'true' ou 'false' (padrao automatico: SSL ativo para hosts remotos, inativo para localhost)
DATABASE_SSL=
# SQLite local (opcional - padrao: backend/data/mindmap.sqlite)
SQLITE_DB_PATH=

# Cookies de sessao em PRD (opcional - configuracao automatica por padrao)
# - Sem dominio proprio (*.pages.dev + *.koyeb.app): deixe COOKIE_DOMAIN vazio (usa SameSite=None + Secure)
# - Com dominio proprio compartilhado: COOKIE_DOMAIN=.seudominio.com e COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_SAME_SITE=
COOKIE_SECURE=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Google Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
